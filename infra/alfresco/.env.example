# Copier vers .env avant le premier démarrage :
#   cp .env.example .env
#
# Le fichier .env est ignoré par git.

COMPOSE_PROJECT_NAME=alfresco-local

# Versions figées (ACS Community 26.2)
ACS_VERSION=26.2.0
SHARE_VERSION=26.2.2
TRANSFORM_VERSION=5.4.4
POSTGRES_VERSION=17.9
ELASTICSEARCH_VERSION=8.17.10
BATCH_INDEXING_VERSION=5.8.0
ACTIVEMQ_VERSION=6.2.9-jre17-rockylinux8

# Point d'accès local (lié à 127.0.0.1, pas exposé sur la box)
ALFRESCO_PUBLIC_HOST=localhost
ALFRESCO_PROTOCOL=http
ALFRESCO_PORT=8080
SHARE_PORT=8081
ACTIVEMQ_CONSOLE_PORT=8161

# Accès distant via Cloudflare Tunnel. Laisser commenté tant que le local
# n'est pas vérifié. Le port annoncé aux clients (443) est distinct du port
# local (8080 / 8081) : aucun port entrant n'est ouvert sur la machine.
# ALFRESCO_PUBLIC_HOST=alfresco.ton-domaine.fr
# ALFRESCO_PROTOCOL=https
# ALFRESCO_PUBLIC_PORT=443
# SHARE_PUBLIC_PORT=443
# ALFRESCO_PUBLIC_BASEURL=https://alfresco.ton-domaine.fr
# SHARE_PUBLIC_ORIGIN=https://alfresco.ton-domaine.fr
# Jeton créé dans Cloudflare Zero Trust > Networks > Tunnels. Ne pas le committer.
# CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL (utilisé par ACS et batch-indexing)
DB_USER=alfresco
DB_PASSWORD=alfresco
DB_NAME=alfresco

# ActiveMQ
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin

# Secret partagé ACS <-> batch-indexing (transformations)
TRANSFORM_SHARED_SECRET=secret

# Compte bootstrap Alfresco.
# L'image initialise admin / admin. Ces variables servent aux scripts d'appel API.
# Après un changement du mot de passe dans Share, mettre à jour ALFRESCO_ADMIN_PASSWORD.
ALFRESCO_ADMIN_USER=admin
ALFRESCO_ADMIN_PASSWORD=admin
